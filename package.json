{
  "name": "cuyocode-security",
  "version": "0.3.0",
  "private": true,
  "description": "Auditoría de seguridad asistida, local y trazable para equipos que necesitan evidencia y no promesas.",
  "license": "MIT",
  "author": "CuyoCode",
  "repository": {
    "type": "git",
    "url": "https://github.com/CuyoCode/cuyocode-security.git"
  },
  "homepage": "https://github.com/CuyoCode/cuyocode-security",
  "bugs": {
    "url": "https://github.com/CuyoCode/cuyocode-security/issues"
  },
  "engines": {
    "node": "^24.0.0",
    "npm": ">=11.0.0"
  },
  "main": "dist-electron/electron/main/main.js",
  "scripts": {
    "dev": "concurrently -k -n RENDERER,MAIN,PRELOAD,ELECTRON -c blue,green,yellow,magenta \"npm:dev:renderer\" \"npm:dev:main\" \"npm:dev:preload\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.main.build.json --watch",
    "dev:preload": "node scripts/build-preload.js --watch",
    "dev:electron": "wait-on http-get://localhost:5199 dist-electron/electron/main/main.js dist-electron/electron/preload/preload.js && node scripts/launch-electron.js",
    "clean": "node scripts/clean.cjs",
    "build": "npm run build:renderer && npm run build:main && npm run build:preload",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.build.json",
    "build:preload": "node scripts/build-preload.js",
    "type-check": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json --noEmit && vue-tsc -p tsconfig.renderer.json --noEmit",
    "verify": "npm run type-check && npm test && npm run build",
    "preview": "vite preview",
    "electron:build": "npm run verify && electron-builder --config build/electron-builder.yml",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "audit:cli": "node dist-electron/scripts/audit-cli.js",
    "screenshots": "npm run build && node scripts/capture-screenshots.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^5.1.0",
    "concurrently": "^9.2.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.2",
    "pinia": "^3.0.3",
    "typescript": "^5.6.3",
    "vite": "^7.1.11",
    "vitest": "^5.1.0",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3",
    "vue-tsc": "^3.3.14",
    "wait-on": "^8.0.3"
  }
}
